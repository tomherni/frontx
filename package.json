{
  "name": "frontx",
  "version": "1.0.0",
  "description": "Collection of frontx logos",
  "author": "Tom Herni <tomherni@gmail.com>",
  "type": "module",
  "engines": {
    "node": "^24.0.0",
    "npm": "^11.0.0"
  },
  "scripts": {
    "start": "vite --open index.html",
    "build": "rm -rf dist && vite build",
    "lint": "eslint \"**/*.js\" --fix",
    "format": "prettier \"**/*.{html,js,json}\" --write",
    "prepare": "husky"
  },
  "dependencies": {
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lit-labs/rollup-plugin-minify-html-literals": "^0.2.0",
    "eslint": "^10.5.0",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.4",
    "vite": "^8.1.6"
  },
  "lint-staged": {
    "**/*.js": "eslint --fix",
    "**/*.{html,js,json}": "prettier --write"
  }
}
